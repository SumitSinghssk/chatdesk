# Public URL of this Next.js site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
# Set to "true" only when the site runs behind your own reverse proxy (nginx, a load
# balancer...) that appends the visitor IP to X-Forwarded-For. The proxy's IP firewall
# then uses the right-most X-Forwarded-For entry; otherwise those headers are ignored.
TRUST_PROXY=false
# Server-only (never prefix with NEXT_PUBLIC_): sent as X-Internal-Key when the proxy
# fetches the API's firewall list, and checked on POST /api/revalidate when the API clears the
# website cache after an edit. Must match INTERNAL_API_KEY in the API .env.
INTERNAL_API_KEY=
# Server-only: verifies the signed, httpOnly `sk_admin` cookie in src/proxy.ts (admin
# redirect + maintenance bypass). Must be the SAME value as ADMIN_HINT_SECRET in the API
# .env. Without it the proxy can't tell who is signed in: no maintenance bypass, and the
# admin shell (not the proxy) sends signed-out visitors to the login page.
ADMIN_HINT_SECRET=
# Optional: where the admin calls the API. Defaults to same-origin "/api/v1" (proxied to
# NEXT_PUBLIC_API_URL by src/proxy.ts / next.config.ts), which the httpOnly session cookies
# rely on — only change it if the API is served from this same site some other way.
# NEXT_PUBLIC_ADMIN_API_BASE=/api/v1
# Optional error monitoring (https://sentry.io). Empty = off (the SDK is not loaded).
# NEXT_PUBLIC_SENTRY_DSN=
