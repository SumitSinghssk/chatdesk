# Docker settings for the website and admin panel.
# Start the API folder first (it creates the shared "starter-kit" network), then copy
# this file to ".env.docker", fill it in and run (in this folder):
#   docker compose --env-file .env.docker up -d --build

# Public address of the site (no trailing slash). Use https:// in production.
# It is built into the image: rebuild after changing it.
SITE_URL=http://localhost:3000

# Where the site is published on this machine. Keep 127.0.0.1 when a reverse proxy
# (nginx, Caddy, Traefik) on the same host serves it; use 0.0.0.0 to expose it directly.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Must be the SAME values as in the API's .env.docker
ADMIN_HINT_SECRET=
INTERNAL_API_KEY=

# How the frontend reaches the API inside Docker (the API compose service name)
API_INTERNAL_URL=http://api:8001

# Set to true only when a reverse proxy in front of the site adds the visitor IP
# to X-Forwarded-For.
TRUST_PROXY=false

# Optional error monitoring (https://sentry.io). Leave empty to turn it off.
# Built into the image: rebuild after changing it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
