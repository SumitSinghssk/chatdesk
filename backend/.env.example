# Must be "production" on live servers: disables /docs, enables HSTS
# and refuses to start without a strong SECRET_KEY.
APP_ENV=development
APP_URL=http://127.0.0.1:8001
PORT=8001
# Used to build links in emails (password reset)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted for the client IP (rate limiting, firewall, logs).
TRUSTED_PROXIES=127.0.0.1,::1

DATABASE_URL=postgresql://user:password@localhost:5432/starter_kit

# Required in production (min 32 chars). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
# Signs the `sk_admin` cookie the Next.js proxy reads (admin redirect + maintenance
# bypass). Must be the SAME value as ADMIN_HINT_SECRET in the frontend .env.local.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_HINT_SECRET=

# Optional
# DEBUG=false
# SQL_ECHO=false

# Shared secret the Next.js proxy sends as X-Internal-Key to read the firewall
# list (GET /api/v1/website/firewall). Use the same value in the frontend .env.
# Empty = endpoint stays public (a warning is logged in production).
INTERNAL_API_KEY=

# Rate-limit counters: "db" (shared across workers, default) or "memory" (per process, tests)
# RATE_LIMIT_BACKEND=db

# Public base URL for uploaded files. Empty = served by this API at /storage/uploads/...
# Serving uploads from a separate domain/CDN (e.g. https://uploads.example.com) that
# maps to storage/uploads is the strongest isolation for user-supplied files.
# UPLOADS_PUBLIC_URL=https://uploads.example.com

# Optional error monitoring (https://sentry.io). Empty = off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0

# Tests run against this database (name must contain "test"): python -m pytest
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/wati_test
