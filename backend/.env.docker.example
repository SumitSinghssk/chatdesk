# Docker settings for the API, database and scheduler.
# Copy to ".env.docker", fill in the secrets, then run (in this folder):
#   docker compose --env-file .env.docker up -d --build
# Start this folder before the frontend: it creates the shared "starter-kit" network.
#
# Generate each secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# Public address of the website (no trailing slash). Use https:// in production.
SITE_URL=http://localhost:3000

# Database (letters and digits only in the password: it is used inside a URL)
POSTGRES_DB=starter_kit
POSTGRES_USER=starter_kit
POSTGRES_PASSWORD=

# Required secrets, at least 32 characters each.
# ADMIN_HINT_SECRET and INTERNAL_API_KEY must be the SAME in the frontend's .env.docker.
SECRET_KEY=
ADMIN_HINT_SECRET=
INTERNAL_API_KEY=

# What to create on the first start with an empty database:
#   basic = permissions and default settings, no users. Then create your admin:
#           docker compose --env-file .env.docker exec api python manage.py create-admin you@example.com --generate
#   demo  = also demo users (superadmin@gmail.com / Password@123) and demo content
#   none  = only run migrations
AUTO_SEED=basic

# Number of API worker processes
WEB_CONCURRENCY=2

# Optional error monitoring (https://sentry.io). Leave empty to turn it off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
